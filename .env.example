PORT=4000

# Authorization
CRYPT_SALT=10
JWT_SECRET_KEY=secret123123
JWT_SECRET_REFRESH_KEY=secret123123
TOKEN_EXPIRE_TIME=1h
TOKEN_REFRESH_EXPIRE_TIME=24h

# Postgres
POSTGRESS_PORT=5432
POSTGRES_DB=home_library
# Insert your username
POSTGRES_USER=<your_db_user>
# Insert your password
POSTGRES_PASSWORD=<your_db_password>

# Docker database url
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@database:${POSTGRESS_PORT}/${POSTGRES_DB}

# Logging
# Nest JS logging level
# Possible values: 
# 0 - fatal,
# 1 - error,
# 2 - warn,
# 3 - log,
# 4 - debug,
# 5 - verbose
LOG_LEVEL=3
# Limit for log file size in kb
LOG_FILE_SIZE_KB=100